{
  "schema": 1,
  "extensionId": "org.fleet.automation",
  "pages": [
    {
      "id": "automation",
      "title": "Automation Rules",
      "route": "/ext/org.fleet.automation/automation"
    }
  ],
  "actions": [
    {
      "id": "scan-now",
      "label": "Evaluate rules now",
      "target": "global",
      "primary": true
    },
    {
      "id": "list-log",
      "label": "Show application log",
      "target": "global"
    },
    {
      "id": "clear-log",
      "label": "Clear application log",
      "target": "global",
      "danger": true
    },
    {
      "id": "list-hints",
      "label": "Show cross-seed hints",
      "target": "global"
    },
    {
      "id": "list-examples",
      "label": "Show example catalog",
      "target": "global"
    },
    {
      "id": "append-examples",
      "label": "Append examples to rules",
      "target": "global"
    }
  ],
  "panels": [
    {
      "id": "automation",
      "title": "Automation Rules",
      "placement": "settings"
    }
  ],
  "forms": [
    {
      "id": "rules-settings",
      "title": "Automation Rules settings",
      "fields": [
        {
          "name": "enabled",
          "label": "Enabled (auto poll)",
          "kind": "boolean",
          "help": "First enable forces dry-run so you can review the application log before side effects."
        },
        {
          "name": "dryRun",
          "label": "Dry-run (log only, no side effects)",
          "kind": "boolean",
          "help": "Log what would happen without changing torrents."
        },
        {
          "name": "intervalSec",
          "label": "Poll interval (seconds)",
          "kind": "number",
          "required": true,
          "help": "How often the worker wakes up.",
          "placeholder": "60",
          "advanced": true
        },
        {
          "name": "rulesText",
          "label": "Automation Rules (JSON lines — Expert)",
          "kind": "textarea",
          "required": true,
          "advanced": true,
          "help": "Also editable with the visual builder above. One JSON object per line; # comments allowed. Actions: setLabel, moveTo, throttle, pause, stop, notify, crossseedHint.",
          "rows": 12,
          "placeholder": "# one JSON object per line"
        },
        {
          "name": "ruleCount",
          "label": "Parsed rule count (hint after save)",
          "kind": "number",
          "advanced": true
        },
        {
          "name": "everEnabled",
          "label": "Ever enabled (first dry-run already applied)",
          "kind": "boolean",
          "advanced": true
        }
      ],
      "loadMethod": "ext.automation.getSettings",
      "submitMethod": "ext.automation.saveSettings",
      "description": "Build if/then rules visually (or Expert JSON). Start with dry-run, peek the log, then go live."
    }
  ]
}
